{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "disposition",
    "assumptions",
    "implementationSteps",
    "validationPlan",
    "risks"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "type": "string",
      "enum": ["ready_to_implement", "needs_clarification", "blocked"]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementationSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "validationPlan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clarificationQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "questionType", "question"],
        "properties": {
          "questionId": {
            "type": "string",
            "minLength": 1
          },
          "questionType": {
            "type": "string",
            "enum": ["multiple_choice", "yes_no", "short_freeform"]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
