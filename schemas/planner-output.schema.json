{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "assumptions",
    "implementationSteps",
    "validationPlan",
    "risks"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementationSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "validationPlan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
