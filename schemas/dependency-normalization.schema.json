{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edges"
  ],
  "properties": {
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromIssue",
          "toIssue",
          "type",
          "blocking",
          "confidence"
        ],
        "properties": {
          "fromIssue": {
            "type": "integer",
            "minimum": 1
          },
          "toIssue": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "depends_on",
              "blocks",
              "subtask_of",
              "epic_of",
              "related"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
